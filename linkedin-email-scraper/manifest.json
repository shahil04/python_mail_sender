{
  "manifest_version": 3,
  "name": "LinkedIn Email Scraper",
  "version": "1.1",
  "description": "Scrape emails from LinkedIn pages and manage a review/send workflow",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "downloads", "clipboardWrite"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}